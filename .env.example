# SITIO WEB (frontend)
# Estas variables VITE_* se incluyen en el JavaScript público: nunca pongas secretos aquí.
# Debe coincidir con SITE_URL en backend/.env
VITE_SITE_URL=https://colombiamods3d.com

# URL pública del backend del catálogo, sin barra final.
# Debe apuntar al host que también expone /api/contact mediante proxy hacia backend/.
VITE_BACKEND_URL=https://backendmods.colombiamods3d.com

# Endpoint público del formulario. Debe enrutar a backend/ en PORT.
VITE_CONTACT_ENDPOINT=https://colombiamods3d.com/api/contact

# Para desarrollo local, reemplaza solo el endpoint por:
# VITE_CONTACT_ENDPOINT=http://localhost:3001/api/contact
# Y añade http://localhost:5173 a CORS_ORIGINS en backend/.env
