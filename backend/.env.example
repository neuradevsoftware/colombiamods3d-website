# API SMTP (backend privado)
PORT=3001
# 1 si el backend está detrás de un proxy inverso; usa 0 en desarrollo local.
TRUST_PROXY=1
# Incluye los orígenes del sitio y del Vite local. Deben coincidir exactamente con el navegador.
CORS_ORIGINS=https://colombiamods3d.com,https://www.colombiamods3d.com,http://localhost:5173

# Debe coincidir con VITE_SITE_URL en el .env del frontend.
SITE_URL=https://colombiamods3d.com
# URL pública HTTPS del logo del sitio; debe ser accesible desde clientes de correo.
EMAIL_LOGO_URL=https://colombiamods3d.com/icon-512.png

# Credenciales SMTP privadas: nunca usar prefijo VITE_ ni subir valores reales al repositorio.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

SUPPORT_EMAIL=support@colombiamods3d.com
BUSINESS_EMAIL=business@colombiamods3d.com
